// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// FASE 0: Fundamento Multi-tenant & Usuarios
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El rol global ha sido eliminado. 
  // La pertenencia y roles ahora viven en Membership.
  memberships Membership[]
  
  // Sesiones de caja activas
  cashSessions CashRegisterSession[] @relation(name: "UserCashRegisterSessions")

  @@map("users")
}

enum OrgRole {
  OWNER
  ADMIN
  VENDEDOR
  INVENTARIO
  // Se pueden agregar más según evolucione el sistema
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])

  // Módulos activados para esta organización específica
  // Si está vacío, se usan los defaultModules del BusinessType
  enabledModules Json @default("[]")

  // Configuraciones específicas (moneda, zona horaria, impuestos por defecto, etc.)
  settings Json @default("{}")

  memberships    Membership[]
  products       Product[]
  categories     Category[]
  units          UnitOfMeasure[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  batches        Batch[]
  
  // Fase 3: Ventas/POS + Caja
  customers      Customer[]
  cashRegisters  CashRegister[]
  sales          Sale[]
  saleItems      SaleItem[]
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessTypeId])
  @@map("organizations")
}

model Membership {
  id             String  @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole @default(VENDEDOR)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ==========================================
// FASE 1: Catálogo Genérico & Configuración
// ==========================================

model BusinessType {
  id          String  @id @default(uuid())
  code        String  @unique // Ej: "BODEGA", "FERRETERIA", "FARMACIA"
  name        String
  description String?

  // Define qué módulos vienen activos por defecto al crear una org de este tipo
  // Ej: ["inventario", "ventas", "lotes"]
  defaultModules Json @default("[]")

  // Schema JSON que define los atributos dinámicos válidos para Products en este rubro
  // Ej: { "requiresRecipe": {"type": "boolean"}, "batchNumber": {"type": "string"} }
  productSchema Json @default("{}")

  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_types")
}

model Category {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  parentId       String? // Para categorías anidadas
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name]) // Nombres únicos dentro de la misma organización
  @@index([organizationId])
  @@map("categories")
}

model UnitOfMeasure {
  id             String  @id @default(uuid())
  organizationId String
  name           String // Ej: "Unidad", "Kg", "Litro", "Caja"
  symbol         String? // Ej: "u", "kg", "L"
  isFractionable Boolean @default(false) // ¿Se puede vender fraccionado? (Ej: ferretería)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units_of_measure")
}

model Product {
  id             String @id @default(uuid())
  organizationId String

  name        String
  sku         String?
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2) // Costo promedio o último costo

  categoryId String?
  unitId     String?

  // Atributos dinámicos específicos del rubro
  // Ej Farmacia: { "requiresRecipe": true, "laboratory": "Bayer" }
  // Ej Ferretería: { "isBulk": true, "material": "Acero" }
  attributes Json @default("{}")

  isActive Boolean @default(true)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id])
  unit         UnitOfMeasure? @relation(fields: [unitId], references: [id])

  // FASE 2: Gestión de Inventario y Stock
  stockMovements StockMovement[]
  inventory      InventoryItem[]
  batches        Batch[]
  
  // FASE 3: Ventas
  saleItems      SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku]) // SKU único por organización
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

// ==========================================
// FASE 2: Gestión de Inventario y Stock
// ==========================================

model InventoryItem {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  // Cantidad total disponible (suma de todos los lotes no expirados/vencidos)
  quantity Decimal @default(0) @db.Decimal(15, 4)
  reserved Decimal @default(0) @db.Decimal(15, 4) // Reservado para ventas pendientes

  // Valorización
  averageCost Decimal @default(0) @db.Decimal(12, 4) // Costo promedio ponderado

  // Última fecha de actualización
  lastCountedAt DateTime?

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]

  @@unique([productId, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@map("inventory_items")
}

enum MovementType {
  INGRESO       // Entrada inicial, compra, producción, devolución de cliente
  SALIDA        // Venta, merma, robo, obsoleto, consumo interno
  AJUSTE        // Corrección por conteo físico
  TRANSFERENCIA // Entre bodegas (futuro)
}

enum MovementReason {
  // Ingreso
  COMPRA
  PRODUCCION
  DEVOLUCION_CLIENTE
  ENTRADA_INICIAL

  // Salida
  VENTA
  MERMA
  ROBO
  OBSOLETO
  CONSUMO_INTERNO

  // Ajuste
  CONTEO_FISICO
  ERROR_SISTEMA

  // Transferencia
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
}

model StockMovement {
  id             String @id @default(uuid())
  organizationId String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type   MovementType
  reason MovementReason

  quantity   Decimal @db.Decimal(15, 4) // Positivo para ingresos, negativo para salidas (pero se guarda valor absoluto)
  isPositive Boolean // true = ingreso, false = salida

  // Trazabilidad
  batchId String? // Lote afectado (opcional para productos sin lote)
  batch   Batch?  @relation(fields: [batchId], references: [id])

  // Referencias externas
  referenceType String? // Ej: "PURCHASE_ORDER", "SALE", "ADJUSTMENT"
  referenceId   String? // ID del documento externo

  notes       String?
  performedBy String // userId que realizó el movimiento

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([reason])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Batch {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  batchNumber  String // Número de lote proporcionado por proveedor
  serialNumber String? // Para productos con número de serie único

  // Fechas críticas
  manufacturingDate DateTime?
  expirationDate    DateTime? // Null = sin vencimiento

  // Estado del lote
  status BatchStatus @default(ACTIVO)

  // Cantidad actual en este lote específico
  initialQuantity Decimal @db.Decimal(15, 4)
  currentQuantity Decimal @db.Decimal(15, 4)

  // Costo unitario de este lote (para FIFO/PEPS)
  unitCost Decimal @db.Decimal(12, 4)

  // Ubicación física (opcional)
  location String? // Ej: "PASILLO-A-03"

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [productId, organizationId], references: [productId, organizationId])
  movements     StockMovement[]
  
  // FASE 3: Ventas - trazabilidad de lotes en ventas
  saleItems     SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNumber, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@index([expirationDate])
  @@index([status])
  @@map("batches")
}

enum BatchStatus {
  ACTIVO
  RETENIDO // En cuarentena, esperando aprobación de calidad
  VENCIDO
  AGOTADO
}

// ==========================================
// FASE 3: Ventas/POS + Caja
// ==========================================

model Customer {
  id             String @id @default(uuid())
  organizationId String

  // Datos básicos
  name      String
  email     String?
  phone     String?
  document  String? // DNI, RUT, NIT, etc.
  address   String?
  city      String?
  country   String?

  // Datos adicionales dinámicos
  attributes Json @default("{}")

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, document])
  @@index([organizationId])
  @@index([email])
  @@map("customers")
}

model CashRegister {
  id             String @id @default(uuid())
  organizationId String

  name        String // Ej: "Caja Principal", "Caja 2"
  code        String?
  description String?

  // Estado actual
  status CashRegisterStatus @default(CERRADA)
  
  // Usuario asignado actualmente
  currentUserId String?

  // Balance
  openingBalance  Decimal @default(0) @db.Decimal(12, 2) // Saldo inicial
  closingBalance  Decimal? @db.Decimal(12, 2) // Saldo al cerrar
  expectedBalance Decimal? @db.Decimal(12, 2) // Saldo esperado según movimientos

  // Fechas de sesión actual
  openedAt DateTime?
  closedAt DateTime?

  // Usuario que abrió/cerró
  openedByUserId String?
  closedByUserId String?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "OrganizationCashRegisters")
  sessions     CashRegisterSession[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("cash_registers")
}

enum CashRegisterStatus {
  ABIERTA
  CERRADA
  BLOQUEADA
}

model CashRegisterSession {
  id             String @id @default(uuid())
  cashRegisterId String
  organizationId String

  // Usuario que opera la caja
  userId String

  // Balance
  openingBalance Decimal @db.Decimal(12, 2)
  closingBalance Decimal? @db.Decimal(12, 2)
  
  // Movimientos
  totalSales     Decimal @default(0) @db.Decimal(12, 2)
  totalIncome    Decimal @default(0) @db.Decimal(12, 2) // Ingresos extra (ej: abonos de clientes)
  totalExpense   Decimal @default(0) @db.Decimal(12, 2) // Egresos extra (ej: pagos menores, retiros)
  totalRefunds   Decimal @default(0) @db.Decimal(12, 2) // Devoluciones
  totalDiscounts Decimal @default(0) @db.Decimal(12, 2) // Descuentos aplicados

  // Estado
  status CashRegisterSessionStatus @default(ABIERTA)

  // Observaciones
  openingNote  String?
  closingNote  String?
  discrepancyNote String? // Nota si hay diferencia entre esperado y real

  // Fechas
  openedAt DateTime @default(now())
  closedAt DateTime?

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "OrganizationCashRegisterSessions")
  user         User          @relation(fields: [userId], references: [id], name: "UserCashRegisterSessions")
  
  movements    CashMovement[] @relation(name: "SessionCashMovements")
  sales        Sale[]

  @@index([cashRegisterId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@map("cash_register_sessions")
}

enum CashRegisterSessionStatus {
  ABIERTA
  CERRADA
  CANCELADA
}

model CashMovement {
  id             String @id @default(uuid())
  sessionId      String
  organizationId String

  type CashMovementType

  amount Decimal @db.Decimal(12, 2)
  
  reason String // Descripción del motivo
  
  // Referencia opcional
  referenceType String? // Ej: "EXPENSE_CATEGORY", "INCOME_CATEGORY"
  referenceId   String?

  notes String?

  createdAt DateTime @default(now())

  session    Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade, name: "SessionCashMovements")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "OrganizationCashMovements")

  @@index([sessionId])
  @@index([organizationId])
  @@index([type])
  @@map("cash_movements")
}

enum CashMovementType {
  INGRESO_EXTRA   // Ingreso no relacionado con venta (ej: abono de cliente)
  EGRESO          // Gasto menor, retiro, pago
  APERTURA        // Saldo inicial
  CIERRE          // Ajuste final
  RETIRO_PARCIAL  // Retiro parcial de caja (envío a banco)
}

// Alias para la tabla cash_register_sessions - necesario para que CashMovement pueda relacionarse
// Prisma requiere que el modelo relacionado tenga la misma @@map que la tabla real
model Session {
  id             String @id @default(uuid()) @map("id_session")
  cashRegisterId String @map("cashRegisterId_session")
  organizationId String @map("organizationId_session")
  userId         String @map("userId_session")
  openingBalance Decimal @db.Decimal(12, 2) @map("openingBalance_session")
  closingBalance Decimal? @db.Decimal(12, 2) @map("closingBalance_session")
  totalSales     Decimal @default(0) @db.Decimal(12, 2) @map("totalSales_session")
  totalIncome    Decimal @default(0) @db.Decimal(12, 2) @map("totalIncome_session")
  totalExpense   Decimal @default(0) @db.Decimal(12, 2) @map("totalExpense_session")
  totalRefunds   Decimal @default(0) @db.Decimal(12, 2) @map("totalRefunds_session")
  totalDiscounts Decimal @default(0) @db.Decimal(12, 2) @map("totalDiscounts_session")
  status         CashRegisterSessionStatus @default(ABIERTA) @map("status_session")
  openingNote    String? @map("openingNote_session")
  closingNote    String? @map("closingNote_session")
  discrepancyNote String? @map("discrepancyNote_session")
  openedAt       DateTime @default(now()) @map("openedAt_session")
  closedAt       DateTime? @map("closedAt_session")

  cashRegister CashRegister       @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, name: "OrganizationSessions")
  user         User               @relation(fields: [userId], references: [id], name: "UserSessions")
  movements    CashMovement[]     @relation(name: "SessionCashMovements")
  sales        Sale[]

  @@map("sessions")
}

model Sale {
  id             String @id @default(uuid())
  organizationId String

  // Número de comprobante
  invoiceNumber String? // Número de factura/ticket
  invoiceSeries String? // Serie de facturación

  // Cliente (opcional para ventas sin cliente registrado)
  customerId String?

  // Caja/sesión donde se realizó
  cashRegisterSessionId String

  // Estado de la venta
  status SaleStatus @default(COMPLETADA)

  // Totales
  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2) // Descuento global
  tax         Decimal @default(0) @db.Decimal(12, 2) // Impuestos
  total       Decimal @db.Decimal(12, 2)
  amountPaid  Decimal @db.Decimal(12, 2) // Total pagado
  change      Decimal @default(0) @db.Decimal(12, 2) // Vuelto/cambio

  // Tipo de venta
  saleType SaleType @default(MOSTRADOR)

  // Notas
  notes String?
  cancellationReason String? // Motivo de cancelación (si aplica)

  // Fechas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cancelledAt DateTime?

  // Relaciones
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?           @relation(fields: [customerId], references: [id])
  session      CashRegisterSession @relation(fields: [cashRegisterSessionId], references: [id])
  items        SaleItem[]
  payments     Payment[]

  @@index([organizationId])
  @@index([customerId])
  @@index([cashRegisterSessionId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

enum SaleStatus {
  COMPLETADA
  PENDIENTE_PAGO
  CANCELADA
  DEVOLUCION_PARCIAL
  DEVOLUCION_TOTAL
}

enum SaleType {
  MOSTRADOR      // Venta en punto de venta
  DELIVERY       // Delivery
  PEDIDO         // Pedido para retirar después
  RESERVA        // Reserva con pago parcial
}

model SaleItem {
  id             String @id @default(uuid())
  saleId         String
  organizationId String

  // Producto vendido
  productId String
  productName String // Copia del nombre al momento de la venta (histórico)
  
  // Cantidad y precio
  quantity Decimal @db.Decimal(15, 4)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2) // Descuento por ítem
  tax       Decimal @default(0) @db.Decimal(12, 2) // Impuesto por ítem
  subtotal  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  // Lote asignado (para trazabilidad)
  batchId String?

  // Notas del ítem
  notes String?

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  batch Batch? @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([organizationId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id             String @id @default(uuid())
  saleId         String
  organizationId String

  // Método de pago
  method PaymentMethod

  // Monto pagado
  amount Decimal @db.Decimal(12, 2)

  // Referencia externa (ej: último 4 dígitos de tarjeta, código de transferencia)
  reference String?

  // Estado
  status PaymentStatus @default(APROBADO)

  // Caja asociada
  cashRegisterId String?

  // Notas
  notes String?

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])

  @@index([saleId])
  @@index([organizationId])
  @@index([method])
  @@map("payments")
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  QR // Pago QR (Yape, Plin, Pix, etc.)
  CHEQUE
  CUENTA_CORRIENTE // Crédito directo a cliente
  OTRO
}

enum PaymentStatus {
  APROBADO
  PENDIENTE
  RECHAZADO
  ANULADO
}
