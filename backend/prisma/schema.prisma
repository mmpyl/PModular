// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// FASE 0: Fundamento Multi-tenant & Usuarios
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hash
  name      String?
  
  // Rol de plataforma (opcional, para acceso global fuera del contexto tenant)
  platformRole PlatformRole?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El rol global ha sido eliminado. 
  // La pertenencia y roles ahora viven en Membership.
  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

enum OrgRole {
  OWNER
  ADMIN
  VENDEDOR
  INVENTARIO
  CAJA
  // Se pueden agregar más según evolucione el sistema
}

// Rol de plataforma - acceso global fuera del contexto tenant
enum PlatformRole {
  PLATFORM_ADMIN
  SUPPORT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])

  // Módulo de suspensión de organizaciones (Fase 4)
  status OrganizationStatus @default(ACTIVE)

  // Módulos activados para esta organización específica
  // Si está vacío, se usan los defaultModules del BusinessType
  enabledModules Json @default("[]")

  // Configuraciones específicas (moneda, zona horaria, impuestos por defecto, etc.)
  settings Json @default("{}")

  // Relaciones - Fase E: Multi-almacén
  warehouses           Warehouse[]
  warehouseInventories WarehouseInventory[]
  stockTransfers       StockTransfer[]

  memberships       Membership[]
  products          Product[]
  categories        Category[]
  units             UnitOfMeasure[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  batches           Batch[]
  businessEntities  BusinessEntity[]
  purchaseOrders    PurchaseOrder[]
  sales             Sale[]
  invoices          Invoice[]
  payments          Payment[]
  accountEntries    CustomerAccountEntry[]
  cashRegisters     CashRegister[]
  auditLogs         AuditLog[]
  
  // FE2: Configuración fiscal por organización
  fiscalSettings OrganizationFiscalSettings?

  // FASE B2: Mermas y vencimientos
  shrinkageRecords    ShrinkageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessTypeId])
  @@map("organizations")
}

model Membership {
  id             String  @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole @default(VENDEDOR)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ==========================================
// FASE 1: Catálogo Genérico & Configuración
// ==========================================

model BusinessType {
  id          String  @id @default(uuid())
  code        String  @unique // Ej: "BODEGA", "FERRETERIA", "FARMACIA"
  name        String
  description String?

  // Define qué módulos vienen activos por defecto al crear una org de este tipo
  // Ej: ["inventario", "ventas", "lotes"]
  defaultModules Json @default("[]")

  // Schema JSON que define los atributos dinámicos válidos para Products en este rubro
  // Ej: { "requiresRecipe": {"type": "boolean"}, "batchNumber": {"type": "string"} }
  productSchema Json @default("{}")

  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_types")
}

model Category {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  parentId       String? // Para categorías anidadas
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name]) // Nombres únicos dentro de la misma organización
  @@index([organizationId])
  @@map("categories")
}

model UnitOfMeasure {
  id             String  @id @default(uuid())
  organizationId String
  name           String // Ej: "Unidad", "Kg", "Litro", "Caja"
  symbol         String? // Ej: "u", "kg", "L"
  isFractionable Boolean @default(false) // ¿Se puede vender fraccionado? (Ej: ferretería)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units_of_measure")
}

model Product {
  id             String @id @default(uuid())
  organizationId String

  name        String
  sku         String?
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2) // Costo promedio o último costo

  categoryId String?
  unitId     String?

  // Atributos dinámicos específicos del rubro
  // Ej Farmacia: { "requiresRecipe": true, "laboratory": "Bayer" }
  // Ej Ferretería: { "isBulk": true, "material": "Acero" }
  attributes Json @default("{}")

  // Fase E: Umbral de stock bajo configurable por producto
  lowStockThreshold Decimal @default(10) @db.Decimal(10, 2)

  isActive Boolean @default(true)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id])
  unit         UnitOfMeasure? @relation(fields: [unitId], references: [id])

  // FASE 2: Gestión de Inventario y Stock
  stockMovements    StockMovement[]
  inventory         InventoryItem[]
  batches           Batch[]
  purchaseOrderItems PurchaseOrderItem[]
  saleItems         SaleItem[]

  // FASE E: Inventario por almacén
  warehouseInventory WarehouseInventory[]
  transferItems      StockTransferItem[]

  // FASE B2: Mermas y vencimientos
  shrinkageRecords ShrinkageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku]) // SKU único por organización
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

// ==========================================
// FASE 2: Gestión de Inventario y Stock
// ==========================================

model InventoryItem {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  // Cantidad total disponible (suma de todos los lotes no expirados/vencidos)
  quantity Decimal @default(0) @db.Decimal(15, 4)
  reserved Decimal @default(0) @db.Decimal(15, 4) // Reservado para ventas pendientes

  // Valorización
  averageCost Decimal @default(0) @db.Decimal(12, 4) // Costo promedio ponderado

  // Última fecha de actualización
  lastCountedAt DateTime?

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]

  @@unique([productId, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@map("inventory_items")
}

enum MovementType {
  INGRESO       // Entrada inicial, compra, producción, devolución de cliente
  SALIDA        // Venta, merma, robo, obsoleto, consumo interno
  AJUSTE        // Corrección por conteo físico
  TRANSFERENCIA // Entre bodegas (futuro)
}

enum MovementReason {
  // Ingreso
  COMPRA
  PRODUCCION
  DEVOLUCION_CLIENTE
  ENTRADA_INICIAL

  // Salida
  VENTA
  MERMA
  ROBO
  OBSOLETO
  CONSUMO_INTERNO

  // Ajuste
  CONTEO_FISICO
  ERROR_SISTEMA

  // Transferencia
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
}

model StockMovement {
  id             String @id @default(uuid())
  organizationId String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type   MovementType
  reason MovementReason

  quantity   Decimal @db.Decimal(15, 4) // Positivo para ingresos, negativo para salidas (pero se guarda valor absoluto)
  isPositive Boolean // true = ingreso, false = salida

  // Trazabilidad
  batchId String? // Lote afectado (opcional para productos sin lote)
  batch   Batch?  @relation(fields: [batchId], references: [id])

  // Referencias externas
  referenceType String? // Ej: "PURCHASE_ORDER", "SALE", "ADJUSTMENT"
  referenceId   String? // ID del documento externo

  notes       String?
  performedBy String // userId que realizó el movimiento

  createdAt DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder? @relation(fields: [referenceId], references: [id], map: "stock_movements_purchase_order_fkey")
  sale            Sale? @relation(fields: [referenceId], references: [id], map: "stock_movements_sale_fkey")

  // FASE B2: Registro de merma vinculado a este movimiento (1:1)
  shrinkageRecord ShrinkageRecord?

  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([reason])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Batch {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  batchNumber  String // Número de lote proporcionado por proveedor
  serialNumber String? // Para productos con número de serie único

  // Fechas críticas
  manufacturingDate DateTime?
  expirationDate    DateTime? // Null = sin vencimiento

  // Estado del lote
  status BatchStatus @default(ACTIVO)

  // Cantidad actual en este lote específico
  initialQuantity Decimal @db.Decimal(15, 4)
  currentQuantity Decimal @db.Decimal(15, 4)

  // Costo unitario de este lote (para FIFO/PEPS)
  unitCost Decimal @db.Decimal(12, 4)

  // Ubicación física (opcional)
  location String? // Ej: "PASILLO-A-03"

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [productId, organizationId], references: [productId, organizationId])
  movements     StockMovement[]
  saleItems     SaleItem[]

  // FASE B2: Mermas registradas sobre este lote
  shrinkageRecords ShrinkageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNumber, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@index([expirationDate])
  @@index([status])
  @@map("batches")
}

enum BatchStatus {
  ACTIVO
  RETENIDO // En cuarentena, esperando aprobación de calidad
  VENCIDO
  AGOTADO
}

// ==========================================
// FASE B2: Control de mermas y vencimientos
// (productos perecibles: lácteos, pan, embutidos)
// ==========================================

model ShrinkageRecord {
  id             String @id @default(uuid())
  organizationId String

  recordNumber String // Ej: MER-2025-0001 (correlativo por organización)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Lote afectado (recomendado para productos con trazabilidad por lote)
  batchId   String?
  batch     Batch?  @relation(fields: [batchId], references: [id])

  // Motivo de la pérdida (subclasifica el MovementReason MERMA/ROBO/OBSOLETO)
  reason ShrinkageReason

  quantity    Decimal         @db.Decimal(15, 4) // Cantidad perdida (> 0)
  unitCost    Decimal         @db.Decimal(12, 4) // Costo unitario al momento de la merma
  totalLoss   Decimal         @db.Decimal(12, 2) // Valor económico perdido = quantity * unitCost
  lossPercent Decimal?        @db.Decimal(5, 2)  // % respecto a la cantidad inicial del lote (si aplica)
  occurredAt  DateTime        @default(now())    // Fecha en que ocurrió la pérdida
  notes       String?

  // Movimiento de stock SALIDA generado automáticamente (trazabilidad contable)
  stockMovementId String?

  recordedBy String // userId que registró la merma

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([productId])
  @@index([batchId])
  @@index([reason])
  @@index([occurredAt])
  @@map("shrinkage_records")
}

enum ShrinkageReason {
  VENCIMIENTO    // Producto vencido retirado de venta
  DANIO          // Rotura, aplastamiento, fuga de envase
  DESCOMPOSICION // Pudrición, corte incorrecto, pérdida de cadena de frío
  ROBO           // Faltante atribuido a robo/hurto
  OTROS
}

// ==========================================
// FASE E: Gestión de Inventario Avanzada - Multi-almacén
// ==========================================

model Warehouse {
  id             String @id @default(uuid())
  organizationId String

  name           String // Ej: "Almacén Principal", "Sucursal Centro"
  code           String // Código único para referencia
  address        String?
  city           String?
  isActive       Boolean @default(true)

  // Configuraciones específicas
  settings       Json @default("{}")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory      WarehouseInventory[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model WarehouseInventory {
  id             String @id @default(uuid())
  warehouseId    String
  productId      String
  organizationId String

  // Cantidad total disponible en este almacén
  quantity Decimal @default(0) @db.Decimal(15, 4)
  reserved Decimal @default(0) @db.Decimal(15, 4)

  // Última fecha de actualización
  lastCountedAt DateTime?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@index([organizationId])
  @@map("warehouse_inventory")
}

enum StockTransferStatus {
  PENDIENTE
  EN_TRANSITO
  RECIBIDA_PARCIALMENTE
  COMPLETADA
  CANCELADA
}

model StockTransfer {
  id             String @id @default(uuid())
  organizationId String

  transferNumber String // Número único de transferencia
  fromWarehouseId String // Almacén de origen
  toWarehouseId   String // Almacén de destino

  status         StockTransferStatus @default(PENDIENTE)

  // Fechas
  transferDate   DateTime @default(now())
  shippedDate    DateTime?
  receivedDate   DateTime?

  // Responsables
  shippedBy      String?
  receivedBy     String?

  // Notas
  notes          String?
  internalNotes  String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromWarehouse  Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse    Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items          StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, transferNumber])
  @@index([organizationId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id            String @id @default(uuid())
  transferId    String
  productId     String

  // Cantidad
  quantityShipped   Decimal @db.Decimal(15, 4)
  quantityReceived  Decimal @default(0) @db.Decimal(15, 4)

  // Costo unitario (para valorización)
  unitCost      Decimal @db.Decimal(12, 4)

  // Trazabilidad de lote (opcional)
  batchNumber   String?
  expirationDate DateTime?

  notes         String?

  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

// ==========================================
// FASE 4: Compras + Proveedores + Clientes
// ==========================================

enum EntityType {
  PROVEEDOR
  CLIENTE
  AMBOS
}

model BusinessEntity {
  id             String @id @default(uuid())
  organizationId String

  // Tipo de entidad
  entityType EntityType @default(AMBOS)

  // Datos fiscales básicos
  name           String  // Razón social o nombre comercial
  taxId          String? // RUC, NIT, DNI, según país
  email          String?
  phone          String?
  mobile         String?
  
  // Dirección
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String  @default("PE") // Perú por defecto
  
  // Contacto principal
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  
  // Información adicional
  notes          String?
  attributes     Json @default("{}") // Atributos dinámicos específicos
  
  // Fase 5: Gestión financiera básica
  creditLimit    Decimal? @db.Decimal(12, 2) // Límite de crédito (null = sin límite)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2) // Saldo pendiente (positivo = debe, negativo = haber)

  // Fase B1: Cuenta corriente / fiado formal
  creditDays     Int? // Plazo de crédito en días para vencimientos automáticos del fiado (null = sin plazo)
  
  isActive       Boolean @default(true)
  
  // Relaciones
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  sales          Sale[]
  accountEntries CustomerAccountEntry[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([entityType])
  @@index([taxId])
  @@map("business_entities")
}

enum PurchaseOrderStatus {
  BORRADOR
  ENVIADA
  CONFIRMADA
  PARCIALMENTE_RECIBIDA
  COMPLETADA
  CANCELADA
}

enum PaymentTerm {
  CONTADO
  CREDITO_7_DIAS
  CREDITO_15_DIAS
  CREDITO_30_DIAS
  CREDITO_60_DIAS
  CREDITO_90_DIAS
  PERSONALIZADO
}

model PurchaseOrder {
  id             String @id @default(uuid())
  organizationId String
  
  orderNumber    String // Número de orden generado internamente
  supplierId     String
  supplier       BusinessEntity @relation(fields: [supplierId], references: [id])
  
  status         PurchaseOrderStatus @default(BORRADOR)
  
  // Fechas
  orderDate      DateTime @default(now())
  expectedDeliveryDate DateTime?
  receivedDate   DateTime?
  
  // Términos de pago
  paymentTerm    PaymentTerm @default(CONTADO)
  paymentDueDate DateTime?
  
  // Totales
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0.18) @db.Decimal(5, 4) // IGV 18% por defecto
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  
  currency       String @default("PEN") // Soles peruanos
  
  // Notas
  notes          String?
  internalNotes  String?
  
  // Referencia externa (orden del proveedor, cotización, etc.)
  externalReference String?
  
  // Usuario que creó la orden
  createdBy      String
  
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PurchaseOrderItem[]
  stockMovements StockMovement[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String @id @default(uuid())
  purchaseOrderId String
  
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  
  // Cantidad
  quantityOrdered   Decimal @db.Decimal(15, 4)
  quantityReceived  Decimal @default(0) @db.Decimal(15, 4)
  
  // Precios
  unitCost      Decimal @db.Decimal(12, 4)
  discount      Decimal @default(0) @db.Decimal(12, 4)
  taxRate       Decimal @default(0.18) @db.Decimal(5, 4)
  
  // Totales por línea
  subtotal      Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  
  // Trazabilidad
  batchNumber   String? // Lote asignado al recibir
  expirationDate DateTime?
  
  notes         String?
  
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

enum SaleStatus {
  BORRADOR
  CONFIRMADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
  DEVUELTA_PARCIAL
  DEVUELTA_TOTAL
}

enum SaleType {
  VENTA_MOSTRADOR
  PEDIDO
  RESERVA
  ENTREGA_DOMICILIO
}

model Sale {
  id             String @id @default(uuid())
  organizationId String
  
  saleNumber     String // Número de venta/factura
  customerId     String?
  customer       BusinessEntity? @relation(fields: [customerId], references: [id])
  
  type           SaleType @default(VENTA_MOSTRADOR)
  status         SaleStatus @default(CONFIRMADA)
  
  // Fechas
  saleDate       DateTime @default(now())
  deliveryDate   DateTime?
  
  // Términos de pago
  paymentTerm    PaymentTerm @default(CONTADO)
  paymentDueDate DateTime?
  
  // Totales
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0.18) @db.Decimal(5, 4)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  
  // Pagos recibidos (para control de saldo pendiente)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountPending  Decimal @default(0) @db.Decimal(12, 2)
  
  currency       String @default("PEN")
  
  // Notas
  notes          String?
  internalNotes  String?
  
  // Usuario que realizó la venta
  soldBy         String
  
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          SaleItem[]
  stockMovements StockMovement[]
  payments       Payment[]
  invoice        Invoice?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id            String @id @default(uuid())
  saleId        String
  
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  
  // Cantidad
  quantity      Decimal @db.Decimal(15, 4)
  
  // Precios
  unitPrice     Decimal @db.Decimal(12, 4)
  discount      Decimal @default(0) @db.Decimal(12, 4)
  taxRate       Decimal @default(0.18) @db.Decimal(5, 4)
  
  // Totales por línea
  subtotal      Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  
  // Trazabilidad (lote usado para esta venta - FIFO)
  batchId       String?
  batch         Batch? @relation(fields: [batchId], references: [id])
  
  notes         String?
  
  sale          Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  YAPE_PLIN
  CHEQUE
  CREDITO_EMPRESA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  PARCIAL
  RECHAZADO
  REEMBOLSADO
}

model Payment {
  id             String @id @default(uuid())
  organizationId String
  
  // Referencia al documento (venta o compra)
  referenceType String // "SALE" o "PURCHASE_ORDER"
  referenceId   String
  
  amount         Decimal @db.Decimal(12, 2)
  
  method         PaymentMethod
  status         PaymentStatus @default(PENDIENTE)
  
  // Fecha de pago
  paymentDate    DateTime @default(now())
  
  // Detalles según método
  cardLastFour   String? // Para tarjetas
  transactionId  String? // ID de transacción bancaria o pasarela
  bankName       String?
  checkNumber    String? // Para cheques
  
  notes          String?
  
  // Usuario que registró el pago
  processedBy    String
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale?      @relation(fields: [referenceId], references: [id], map: "payments_sale_fkey")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([referenceType, referenceId])
  @@index([paymentDate])
  @@map("payments")
}

// ==========================================
// FASE 3 - Caja (Cash Registers)
// ==========================================

model CashRegister {
  id             String @id @default(uuid())
  organizationId String
  
  name        String
  description String?
  status      String @default("CERRADA") // ABIERTA, CERRADA, EN_PAUSA
  
  // Usuario actual responsable
  currentUserId String?
  
  // Balance
  openingBalance        Decimal @default(0) @db.Decimal(12, 2)
  expectedClosingBalance Decimal @default(0) @db.Decimal(12, 2)
  actualClosingBalance  Decimal? @db.Decimal(12, 2)
  difference            Decimal? @db.Decimal(12, 2)
  
  // Fechas de sesión
  openedAt  DateTime?
  closedAt  DateTime?
  
  // Notas
  openingNotes  String?
  closingNotes  String?
  
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements       CashRegisterMovement[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@map("cash_registers")
}

enum CashRegisterMovementType {
  APERTURA
  INGRESO_VENTA
  INGRESO_OTRO
  SALIDA_GASTO
  SALIDA_RETIRO
  CIERRE
  AJUSTE
}

model CashRegisterMovement {
  id             String @id @default(uuid())
  organizationId String
  cashRegisterId String
  
  type        CashRegisterMovementType
  amount      Decimal @db.Decimal(12, 2)
  isPositive  Boolean
  paymentMethod String? // EFECTIVO, TARJETA, etc.
  description String
  notes       String?
  saleId      String? // Referencia a venta si aplica
  performedBy String
  
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([cashRegisterId])
  @@index([organizationId])
  @@index([performedBy])
  @@map("cash_register_movements")
}

// ==========================================
// FASE A: AuditLog - Trazabilidad de plataforma
// ==========================================

// ==========================================
// FASE B1 - Cuenta corriente / fiado formal
// ==========================================

enum AccountEntryType {
  CREDITO // Aumenta la deuda del cliente (venta fiada, ajuste)
  DEBITO // Reduce la deuda (abono, nota de crédito por devolución)
}

enum AccountEntryStatus {
  VIGENTE
  ANULADO
}

model CustomerAccountEntry {
  id             String @id @default(uuid())
  organizationId String

  entryNumber    String // Identificador humano correlativo por organización (CC-000001)

  customerId     String
  customer       BusinessEntity @relation(fields: [customerId], references: [id])

  type           AccountEntryType
  status         AccountEntryStatus @default(VIGENTE)

  amount         Decimal @db.Decimal(12, 2) // Siempre positivo; el signo lo define `type`

  // Referencia al documento origen (venta o pago)
  referenceType  String? // "SALE" | "PAYMENT"
  referenceId    String?

  // Vencimiento para alertas de mora (null = sin vencimiento, p.ej. abonos)
  dueDate        DateTime?

  description    String?
  notes          String?

  createdBy      String // Usuario que registró el asiento

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entryNumber])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, referenceType, referenceId])
  @@index([dueDate, status])
  @@map("customer_account_entries")
}

enum AuditActionType {
  ORGANIZATION_SUSPENDED
  ORGANIZATION_REACTIVATED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  INVENTORY_ADJUSTED
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_UPDATED
  PURCHASE_ORDER_COMPLETED
  SALE_CREATED
  SALE_CANCELLED
  SALE_RETURNED
  BATCH_CREATED
  BATCH_RETAINED
  BATCH_EXPIRED
  CASH_REGISTER_OPENED
  CASH_REGISTER_CLOSED
  CASH_REGISTER_ADJUSTMENT
  OTHER
}

model AuditLog {
  id             String   @id @default(uuid())
  
  // Quién realizó la acción
  userId         String?  // Puede ser null si es acción automática del sistema
  userPlatformRole PlatformRole? // Rol de plataforma en el momento de la acción
  
  // Qué acción se realizó
  action         AuditActionType
  
  // Sobre qué entidad/organización
  entityType     String   // Ej: "Organization", "User", "Membership", "Product"
  entityId       String   // ID de la entidad afectada
  organizationId String?  // Contexto organizacional (si aplica)
  
  // Metadata específica de cada acción (JSON flexible)
  metadata       Json     @default("{}")
  
  // Cuándo ocurrió
  createdAt      DateTime @default(now())
  
  // Relaciones opcionales para facilitar consultas
  user           User?    @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// FE1: Modelo de datos - Comprobantes Electrónicos (Invoice/ElectronicVoucher)
// ==========================================

enum InvoiceType {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
}

enum InvoiceStatus {
  PENDIENTE
  ENVIADO
  ACEPTADO
  RECHAZADO
  ANULADO
}

model Invoice {
  id             String @id @default(uuid())
  organizationId String
  
  // Tipo de comprobante electrónico
  type           InvoiceType
  
  // Serie y correlativo (ej: F001-00000123)
  series         String
  correlation    String
  
  // Estado del comprobante electrónico
  status         InvoiceStatus @default(PENDIENTE)
  
  // Fecha de emisión
  issueDate      DateTime @default(now())
  
  // Totales (información duplicada desde Sale para referencia)
  subtotal       Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 4)
  taxAmount      Decimal @db.Decimal(12, 2)
  discount       Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  
  currency       String @default("PEN")
  
  // Datos del cliente (información fiscal al momento de la emisión)
  customerName   String?
  customerTaxId  String? // RUC/DNI
  customerAddress String?
  
  // Respuesta de SUNAT / OSE
  sunatResponseCode String?
  sunatResponseMessage String?
  cdrHash        String? // Hash del Constancia de Recepción
  cdrXml         String? // XML de la constancia (o ruta de almacenamiento)
  ubige          String? // Código de ubige
  
  // UUID del comprobante (para identificación única)
  uuid           String?
  
  // Notas
  notes          String?
  internalNotes  String?
  
  // Usuario que generó el comprobante
  issuedBy       String
  
  // Relación con Sale
  saleId         String? @unique
  sale           Sale? @relation(fields: [saleId], references: [id])
  
  // Relación con VoucherArchive (FE7)
  archive        VoucherArchive?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([saleId])
  @@index([series, correlation])
  @@map("invoices")
}

// ==========================================
// FE7: Archivo y Auditoría de Comprobantes (Retención 5 años)
// ==========================================

model VoucherArchive {
  id             String @id @default(uuid())
  invoiceId      String @unique
  organizationId String
  
  // Contenido del XML firmado enviado a SUNAT
  xmlContent     String @db.Text
  
  // Contenido del CDR (Constancia de Recepción)
  cdrContent     String @db.Text
  
  // Hash SHA-256 del XML para verificación de integridad
  xmlHash        String
  
  // Ruta de almacenamiento externo (S3, GCS) si aplica
  storagePath    String?
  
  // Fecha hasta la cual se debe retener el documento (5 años desde emisión)
  retentionUntil DateTime
  
  // Usuario que archivó el comprobante
  archivedBy     String
  
  // Notas internas
  notes          String?
  
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([retentionUntil])
  @@map("voucher_archives")
}

// ==========================================
// FE2: Configuración Fiscal por Organización (Multi-tenant)
// ==========================================

model OrganizationFiscalSettings {
  id             String @id @default(uuid())
  organizationId String @unique
  
  // Datos fiscales de la organización
  ruc            String // RUC único de la organización
  razonSocial    String // Razón social registrada
  nombreComercial String? // Nombre comercial (opcional)
  
  // Dirección fiscal
  direccion      String
  ubige          String // Código de ubige del distrito
  departamento   String
  provincia      String
  distrito       String
  
  // Teléfono y contacto
  telefono       String?
  email          String?
  
  // Configuración de series autorizadas por tipo de comprobante
  // Ej: { "FACTURA": ["F001", "F002"], "BOLETA": ["B001"], "NOTA_CREDITO": ["FC01"], "NOTA_DEBITO": ["FD01"] }
  seriesAutorizadas Json @default("{}")
  
  // Serie actual por tipo de comprobante (para correlativo automático)
  serieActualFactura String @default("F001")
  serieActualBoleta String @default("B001")
  serieActualNotaCredito String @default("FC01")
  serieActualNotaDebito String @default("FD01")
  
  // Último correlativo usado por serie
  // Ej: { "F001": 1234, "B001": 5678 }
  ultimosCorrelativos Json @default("{}")
  
  // Credenciales del PSE (Proveedor de Servicios Electrónicos)
  pseProvider    String? // Nombre del proveedor PSE (ej: "NUBEFACT", "SOLUTEC", etc.)
  pseUsername    String? // Usuario/API key del PSE
  psePassword    String? // Contraseña/secret del PSE (encriptada)
  pseEnvironment String @default("BETA") // BETA o PRODUCCION
  
  // Certificado digital (opcional, para firmado de XML)
  certificadoDigital String? // Ruta o contenido del certificado .pfx/.p12
  certificadoPassword String? // Contraseña del certificado
  
  // Configuración de impuestos
  igvRate        Decimal @default(18.00) @db.Decimal(5, 2) // IGV por defecto
  icbperRate     Decimal? @db.Decimal(5, 2) // ICBPER si aplica
  
  // Configuración de moneda
  moneda         String @default("PEN") // PEN o USD
  
  // Estado de la configuración fiscal
  isActive       Boolean @default(true)
  isConfigured   Boolean @default(false) // true cuando todos los datos requeridos están completos
  
  // Fecha de última sincronización con SUNAT
  lastSunatSync DateTime?
  
  // Notas internas
  notasInternas  String?
  
  // Relación con Organization
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([ruc])
  @@map("organization_fiscal_settings")
}
