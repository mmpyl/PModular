// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// FASE 0: Fundamento Multi-tenant & Usuarios
// ==========================================

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String       // Hash
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // El rol global ha sido eliminado. 
  // La pertenencia y roles ahora viven en Membership.
  memberships Membership[]

  @@map("users")
}

enum OrgRole {
  OWNER
  ADMIN
  VENDEDOR
  INVENTARIO
  // Se pueden agregar más según evolucione el sistema
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])
  
  // Módulos activados para esta organización específica
  // Si está vacío, se usan los defaultModules del BusinessType
  enabledModules Json     @default("[]") 
  
  // Configuraciones específicas (moneda, zona horaria, impuestos por defecto, etc.)
  settings       Json     @default("{}")
  
  memberships    Membership[]
  products       Product[]
  categories     Category[]
  units          UnitOfMeasure[]
  warehouses     Warehouse[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  adjustments    StockAdjustment[]
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([businessTypeId])
  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole      @default(VENDEDOR)
  
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ==========================================
// FASE 1: Catálogo Genérico & Configuración
// ==========================================

model BusinessType {
  id            String   @id @default(uuid())
  code          String   @unique   // Ej: "BODEGA", "FERRETERIA", "FARMACIA"
  name          String
  description   String?
  
  // Define qué módulos vienen activos por defecto al crear una org de este tipo
  // Ej: ["inventario", "ventas", "lotes"]
  defaultModules Json    @default("[]")   
  
  // Schema JSON que define los atributos dinámicos válidos para Products en este rubro
  // Ej: { "requiresRecipe": {"type": "boolean"}, "batchNumber": {"type": "string"} }
  productSchema Json     @default("{}")   
  
  organizations Organization[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("business_types")
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  parentId       String?      // Para categorías anidadas
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  
  @@unique([organizationId, name]) // Nombres únicos dentro de la misma organización
  @@index([organizationId])
  @@map("categories")
}

model UnitOfMeasure {
  id             String       @id @default(uuid())
  organizationId String
  name           String       // Ej: "Unidad", "Kg", "Litro", "Caja"
  symbol         String?      // Ej: "u", "kg", "L"
  isFractionable Boolean      @default(false) // ¿Se puede vender fraccionado? (Ej: ferretería)
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units_of_measure")
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  
  name           String
  sku            String?
  description    String?
  price          Decimal      @db.Decimal(10, 2)
  cost           Decimal?     @db.Decimal(10, 2) // Costo promedio o último costo
  
  categoryId     String?
  unitId         String?
  
  // Atributos dinámicos específicos del rubro
  // Ej Farmacia: { "requiresRecipe": true, "laboratory": "Bayer" }
  // Ej Ferretería: { "isBulk": true, "material": "Acero" }
  attributes     Json         @default("{}") 
  
  isActive       Boolean      @default(true)
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id])
  unit           UnitOfMeasure? @relation(fields: [unitId], references: [id])
  
  // Fase 2: Inventario
  stockItems     StockItem[]
  stockMovements StockMovement[]
  adjustmentItems StockAdjustmentItem[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, sku]) // SKU único por organización
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

// ==========================================
// FASE 2: Módulo de Inventario
// ==========================================

enum MovementType {
  IN_PURCHASE      // Entrada por compra
  IN_ADJUSTMENT    // Entrada por ajuste (inventario positivo)
  IN_RETURN        // Entrada por devolución
  IN_TRANSFER      // Entrada por transferencia desde otra bodega
  OUT_SALE         // Salida por venta
  OUT_ADJUSTMENT   // Salida por ajuste (merma, pérdida)
  OUT_TRANSFER     // Salida por transferencia a otra bodega
}

model Warehouse {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String?
  address        String?
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false) // Bodega principal por defecto
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItems     StockItem[]
  stockMovements StockMovement[]
  adjustments    StockAdjustment[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code]) // Código único por organización
  @@index([organizationId])
  @@map("warehouses")
}

model StockItem {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  
  quantity       Int          @default(0) // Cantidad disponible
  reserved       Int          @default(0) // Cantidad reservada (pedidos pendientes)
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  movements      StockMovement[]
  
  @@unique([organizationId, productId, warehouseId]) // Único producto por bodega
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_items")
}

model StockMovement {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  warehouseId    String
  movementType   MovementType
  
  quantity       Int          // Positivo para entradas, negativo para salidas
  balanceAfter   Int          // Stock resultante después del movimiento
  referenceId    String?      // ID de documento relacionado (venta, compra, etc.)
  referenceType  String?      // Tipo de documento (SALE, PURCHASE, etc.)
  notes          String?
  
  createdBy      String       // ID del usuario que registró el movimiento
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItem      StockItem    @relation(fields: [organizationId, productId, warehouseId], references: [organizationId, productId, warehouseId])
  
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([movementType])
  @@index([referenceId])
  @@map("stock_movements")
}

enum AdjustmentStatus {
  PENDING        // Esperando aprobación
  APPROVED       // Aprobado y procesado
  REJECTED       // Rechazado
}

model StockAdjustment {
  id             String           @id @default(uuid())
  organizationId String
  warehouseId    String
  status         AdjustmentStatus @default(PENDING)
  
  reason         String
  notes          String?
  
  requestedBy    String           // Usuario que solicitó el ajuste
  approvedBy     String?          // Usuario que aprobó
  approvedAt     DateTime?
  
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items          StockAdjustmentItem[]
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String            @id @default(uuid())
  adjustmentId      String
  productId         String
  organizationId    String
  
  expectedQuantity  Int               // Cantidad según sistema
  countedQuantity   Int               // Cantidad física contada
  difference        Int               // Diferencia (counted - expected)
  
  adjustment        StockAdjustment   @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([adjustmentId])
  @@index([productId])
  @@map("stock_adjustment_items")
}
