// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// FASE 0: Fundamento Multi-tenant & Usuarios
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El rol global ha sido eliminado. 
  // La pertenencia y roles ahora viven en Membership.
  memberships Membership[]

  @@map("users")
}

enum OrgRole {
  OWNER
  ADMIN
  VENDEDOR
  INVENTARIO
  // Se pueden agregar más según evolucione el sistema
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])

  // Módulos activados para esta organización específica
  // Si está vacío, se usan los defaultModules del BusinessType
  enabledModules Json @default("[]")

  // Configuraciones específicas (moneda, zona horaria, impuestos por defecto, etc.)
  settings Json @default("{}")

  memberships       Membership[]
  products          Product[]
  categories        Category[]
  units             UnitOfMeasure[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  batches           Batch[]
  businessEntities  BusinessEntity[]
  purchaseOrders    PurchaseOrder[]
  sales             Sale[]
  payments          Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessTypeId])
  @@map("organizations")
}

model Membership {
  id             String  @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole @default(VENDEDOR)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ==========================================
// FASE 1: Catálogo Genérico & Configuración
// ==========================================

model BusinessType {
  id          String  @id @default(uuid())
  code        String  @unique // Ej: "BODEGA", "FERRETERIA", "FARMACIA"
  name        String
  description String?

  // Define qué módulos vienen activos por defecto al crear una org de este tipo
  // Ej: ["inventario", "ventas", "lotes"]
  defaultModules Json @default("[]")

  // Schema JSON que define los atributos dinámicos válidos para Products en este rubro
  // Ej: { "requiresRecipe": {"type": "boolean"}, "batchNumber": {"type": "string"} }
  productSchema Json @default("{}")

  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_types")
}

model Category {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  parentId       String? // Para categorías anidadas
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name]) // Nombres únicos dentro de la misma organización
  @@index([organizationId])
  @@map("categories")
}

model UnitOfMeasure {
  id             String  @id @default(uuid())
  organizationId String
  name           String // Ej: "Unidad", "Kg", "Litro", "Caja"
  symbol         String? // Ej: "u", "kg", "L"
  isFractionable Boolean @default(false) // ¿Se puede vender fraccionado? (Ej: ferretería)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units_of_measure")
}

model Product {
  id             String @id @default(uuid())
  organizationId String

  name        String
  sku         String?
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2) // Costo promedio o último costo

  categoryId String?
  unitId     String?

  // Atributos dinámicos específicos del rubro
  // Ej Farmacia: { "requiresRecipe": true, "laboratory": "Bayer" }
  // Ej Ferretería: { "isBulk": true, "material": "Acero" }
  attributes Json @default("{}")

  isActive Boolean @default(true)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id])
  unit         UnitOfMeasure? @relation(fields: [unitId], references: [id])

  // FASE 2: Gestión de Inventario y Stock
  stockMovements    StockMovement[]
  inventory         InventoryItem[]
  batches           Batch[]
  purchaseOrderItems PurchaseOrderItem[]
  saleItems         SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku]) // SKU único por organización
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

// ==========================================
// FASE 2: Gestión de Inventario y Stock
// ==========================================

model InventoryItem {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  // Cantidad total disponible (suma de todos los lotes no expirados/vencidos)
  quantity Decimal @default(0) @db.Decimal(15, 4)
  reserved Decimal @default(0) @db.Decimal(15, 4) // Reservado para ventas pendientes

  // Valorización
  averageCost Decimal @default(0) @db.Decimal(12, 4) // Costo promedio ponderado

  // Última fecha de actualización
  lastCountedAt DateTime?

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]

  @@unique([productId, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@map("inventory_items")
}

enum MovementType {
  INGRESO       // Entrada inicial, compra, producción, devolución de cliente
  SALIDA        // Venta, merma, robo, obsoleto, consumo interno
  AJUSTE        // Corrección por conteo físico
  TRANSFERENCIA // Entre bodegas (futuro)
}

enum MovementReason {
  // Ingreso
  COMPRA
  PRODUCCION
  DEVOLUCION_CLIENTE
  ENTRADA_INICIAL

  // Salida
  VENTA
  MERMA
  ROBO
  OBSOLETO
  CONSUMO_INTERNO

  // Ajuste
  CONTEO_FISICO
  ERROR_SISTEMA

  // Transferencia
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
}

model StockMovement {
  id             String @id @default(uuid())
  organizationId String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type   MovementType
  reason MovementReason

  quantity   Decimal @db.Decimal(15, 4) // Positivo para ingresos, negativo para salidas (pero se guarda valor absoluto)
  isPositive Boolean // true = ingreso, false = salida

  // Trazabilidad
  batchId String? // Lote afectado (opcional para productos sin lote)
  batch   Batch?  @relation(fields: [batchId], references: [id])

  // Referencias externas
  referenceType String? // Ej: "PURCHASE_ORDER", "SALE", "ADJUSTMENT"
  referenceId   String? // ID del documento externo

  notes       String?
  performedBy String // userId que realizó el movimiento

  createdAt DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder? @relation(fields: [referenceId], references: [id], map: "stock_movements_purchase_order_fkey")
  sale            Sale? @relation(fields: [referenceId], references: [id], map: "stock_movements_sale_fkey")

  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([reason])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Batch {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  batchNumber  String // Número de lote proporcionado por proveedor
  serialNumber String? // Para productos con número de serie único

  // Fechas críticas
  manufacturingDate DateTime?
  expirationDate    DateTime? // Null = sin vencimiento

  // Estado del lote
  status BatchStatus @default(ACTIVO)

  // Cantidad actual en este lote específico
  initialQuantity Decimal @db.Decimal(15, 4)
  currentQuantity Decimal @db.Decimal(15, 4)

  // Costo unitario de este lote (para FIFO/PEPS)
  unitCost Decimal @db.Decimal(12, 4)

  // Ubicación física (opcional)
  location String? // Ej: "PASILLO-A-03"

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [productId, organizationId], references: [productId, organizationId])
  movements     StockMovement[]
  saleItems     SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNumber, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@index([expirationDate])
  @@index([status])
  @@map("batches")
}

enum BatchStatus {
  ACTIVO
  RETENIDO // En cuarentena, esperando aprobación de calidad
  VENCIDO
  AGOTADO
}

// ==========================================
// FASE 4: Compras + Proveedores + Clientes
// ==========================================

enum EntityType {
  PROVEEDOR
  CLIENTE
  AMBOS
}

model BusinessEntity {
  id             String @id @default(uuid())
  organizationId String

  // Tipo de entidad
  entityType EntityType @default(AMBOS)

  // Datos fiscales básicos
  name           String  // Razón social o nombre comercial
  taxId          String? // RUC, NIT, DNI, según país
  email          String?
  phone          String?
  mobile         String?
  
  // Dirección
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String  @default("PE") // Perú por defecto
  
  // Contacto principal
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  
  // Información adicional
  notes          String?
  attributes     Json @default("{}") // Atributos dinámicos específicos
  
  isActive       Boolean @default(true)
  
  // Relaciones
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  sales          Sale[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([entityType])
  @@index([taxId])
  @@map("business_entities")
}

enum PurchaseOrderStatus {
  BORRADOR
  ENVIADA
  CONFIRMADA
  PARCIALMENTE_RECIBIDA
  COMPLETADA
  CANCELADA
}

enum PaymentTerm {
  CONTADO
  CREDITO_7_DIAS
  CREDITO_15_DIAS
  CREDITO_30_DIAS
  CREDITO_60_DIAS
  CREDITO_90_DIAS
  PERSONALIZADO
}

model PurchaseOrder {
  id             String @id @default(uuid())
  organizationId String
  
  orderNumber    String // Número de orden generado internamente
  supplierId     String
  supplier       BusinessEntity @relation(fields: [supplierId], references: [id])
  
  status         PurchaseOrderStatus @default(BORRADOR)
  
  // Fechas
  orderDate      DateTime @default(now())
  expectedDeliveryDate DateTime?
  receivedDate   DateTime?
  
  // Términos de pago
  paymentTerm    PaymentTerm @default(CONTADO)
  paymentDueDate DateTime?
  
  // Totales
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0.18) @db.Decimal(5, 4) // IGV 18% por defecto
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  
  currency       String @default("PEN") // Soles peruanos
  
  // Notas
  notes          String?
  internalNotes  String?
  
  // Referencia externa (orden del proveedor, cotización, etc.)
  externalReference String?
  
  // Usuario que creó la orden
  createdBy      String
  
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PurchaseOrderItem[]
  stockMovements StockMovement[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String @id @default(uuid())
  purchaseOrderId String
  
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  
  // Cantidad
  quantityOrdered   Decimal @db.Decimal(15, 4)
  quantityReceived  Decimal @default(0) @db.Decimal(15, 4)
  
  // Precios
  unitCost      Decimal @db.Decimal(12, 4)
  discount      Decimal @default(0) @db.Decimal(12, 4)
  taxRate       Decimal @default(0.18) @db.Decimal(5, 4)
  
  // Totales por línea
  subtotal      Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  
  // Trazabilidad
  batchNumber   String? // Lote asignado al recibir
  expirationDate DateTime?
  
  notes         String?
  
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

enum SaleStatus {
  BORRADOR
  CONFIRMADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
  DEVUELTA_PARCIAL
  DEVUELTA_TOTAL
}

enum SaleType {
  VENTA_MOSTRADOR
  PEDIDO
  RESERVA
  ENTREGA_DOMICILIO
}

model Sale {
  id             String @id @default(uuid())
  organizationId String
  
  saleNumber     String // Número de venta/factura
  customerId     String?
  customer       BusinessEntity? @relation(fields: [customerId], references: [id])
  
  type           SaleType @default(VENTA_MOSTRADOR)
  status         SaleStatus @default(CONFIRMADA)
  
  // Fechas
  saleDate       DateTime @default(now())
  deliveryDate   DateTime?
  
  // Términos de pago
  paymentTerm    PaymentTerm @default(CONTADO)
  paymentDueDate DateTime?
  
  // Totales
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  taxRate        Decimal @default(0.18) @db.Decimal(5, 4)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  
  // Pagos recibidos (para control de saldo pendiente)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountPending  Decimal @default(0) @db.Decimal(12, 2)
  
  currency       String @default("PEN")
  
  // Notas
  notes          String?
  internalNotes  String?
  
  // Usuario que realizó la venta
  soldBy         String
  
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          SaleItem[]
  stockMovements StockMovement[]
  payments       Payment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id            String @id @default(uuid())
  saleId        String
  
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  
  // Cantidad
  quantity      Decimal @db.Decimal(15, 4)
  
  // Precios
  unitPrice     Decimal @db.Decimal(12, 4)
  discount      Decimal @default(0) @db.Decimal(12, 4)
  taxRate       Decimal @default(0.18) @db.Decimal(5, 4)
  
  // Totales por línea
  subtotal      Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  
  // Trazabilidad (lote usado para esta venta - FIFO)
  batchId       String?
  batch         Batch? @relation(fields: [batchId], references: [id])
  
  notes         String?
  
  sale          Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  YAPE_PLIN
  CHEQUE
  CREDITO_EMPRESA
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  PARCIAL
  RECHAZADO
  REEMBOLSADO
}

model Payment {
  id             String @id @default(uuid())
  organizationId String
  
  // Referencia al documento (venta o compra)
  referenceType String // "SALE" o "PURCHASE_ORDER"
  referenceId   String
  
  amount         Decimal @db.Decimal(12, 2)
  
  method         PaymentMethod
  status         PaymentStatus @default(PENDIENTE)
  
  // Fecha de pago
  paymentDate    DateTime @default(now())
  
  // Detalles según método
  cardLastFour   String? // Para tarjetas
  transactionId  String? // ID de transacción bancaria o pasarela
  bankName       String?
  checkNumber    String? // Para cheques
  
  notes          String?
  
  // Usuario que registró el pago
  processedBy    String
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale?      @relation(fields: [referenceId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([referenceType, referenceId])
  @@index([paymentDate])
  @@map("payments")
}
