// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// FASE 0: Fundamento Multi-tenant & Usuarios
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hash
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // El rol global ha sido eliminado. 
  // La pertenencia y roles ahora viven en Membership.
  memberships Membership[]

  @@map("users")
}

enum OrgRole {
  OWNER
  ADMIN
  VENDEDOR
  INVENTARIO
  // Se pueden agregar más según evolucione el sistema
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id])

  // Módulos activados para esta organización específica
  // Si está vacío, se usan los defaultModules del BusinessType
  enabledModules Json @default("[]")

  // Configuraciones específicas (moneda, zona horaria, impuestos por defecto, etc.)
  settings Json @default("{}")

  memberships    Membership[]
  products       Product[]
  categories     Category[]
  units          UnitOfMeasure[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  batches        Batch[]
  sales          Sale[]
  payments       Payment[]
  cashRegisters  CashRegister[]
  cashRegisterMovements CashRegisterMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessTypeId])
  @@map("organizations")
}

model Membership {
  id             String  @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole @default(VENDEDOR)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ==========================================
// FASE 1: Catálogo Genérico & Configuración
// ==========================================

model BusinessType {
  id          String  @id @default(uuid())
  code        String  @unique // Ej: "BODEGA", "FERRETERIA", "FARMACIA"
  name        String
  description String?

  // Define qué módulos vienen activos por defecto al crear una org de este tipo
  // Ej: ["inventario", "ventas", "lotes"]
  defaultModules Json @default("[]")

  // Schema JSON que define los atributos dinámicos válidos para Products en este rubro
  // Ej: { "requiresRecipe": {"type": "boolean"}, "batchNumber": {"type": "string"} }
  productSchema Json @default("{}")

  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_types")
}

model Category {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  parentId       String? // Para categorías anidadas
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryHierarchy")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name]) // Nombres únicos dentro de la misma organización
  @@index([organizationId])
  @@map("categories")
}

model UnitOfMeasure {
  id             String  @id @default(uuid())
  organizationId String
  name           String // Ej: "Unidad", "Kg", "Litro", "Caja"
  symbol         String? // Ej: "u", "kg", "L"
  isFractionable Boolean @default(false) // ¿Se puede vender fraccionado? (Ej: ferretería)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("units_of_measure")
}

model Product {
  id             String @id @default(uuid())
  organizationId String

  name        String
  sku         String?
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2) // Costo promedio o último costo

  categoryId String?
  unitId     String?

  // Atributos dinámicos específicos del rubro
  // Ej Farmacia: { "requiresRecipe": true, "laboratory": "Bayer" }
  // Ej Ferretería: { "isBulk": true, "material": "Acero" }
  attributes Json @default("{}")

  isActive Boolean @default(true)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id])
  unit         UnitOfMeasure? @relation(fields: [unitId], references: [id])

  // FASE 2: Gestión de Inventario y Stock
  stockMovements StockMovement[]
  inventory      InventoryItem[]
  batches        Batch[]
  
  // FASE 3: Ventas
  saleItems      SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku]) // SKU único por organización
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

// ==========================================
// FASE 2: Gestión de Inventario y Stock
// ==========================================

model InventoryItem {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  // Cantidad total disponible (suma de todos los lotes no expirados/vencidos)
  quantity Decimal @default(0) @db.Decimal(15, 4)
  reserved Decimal @default(0) @db.Decimal(15, 4) // Reservado para ventas pendientes

  // Valorización
  averageCost Decimal @default(0) @db.Decimal(12, 4) // Costo promedio ponderado

  // Última fecha de actualización
  lastCountedAt DateTime?

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]

  @@unique([productId, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@map("inventory_items")
}

enum MovementType {
  INGRESO       // Entrada inicial, compra, producción, devolución de cliente
  SALIDA        // Venta, merma, robo, obsoleto, consumo interno
  AJUSTE        // Corrección por conteo físico
  TRANSFERENCIA // Entre bodegas (futuro)
}

enum MovementReason {
  // Ingreso
  COMPRA
  PRODUCCION
  DEVOLUCION_CLIENTE
  ENTRADA_INICIAL

  // Salida
  VENTA
  MERMA
  ROBO
  OBSOLETO
  CONSUMO_INTERNO

  // Ajuste
  CONTEO_FISICO
  ERROR_SISTEMA

  // Transferencia
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
}

model StockMovement {
  id             String @id @default(uuid())
  organizationId String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type   MovementType
  reason MovementReason

  quantity   Decimal @db.Decimal(15, 4) // Positivo para ingresos, negativo para salidas (pero se guarda valor absoluto)
  isPositive Boolean // true = ingreso, false = salida

  // Trazabilidad
  batchId String? // Lote afectado (opcional para productos sin lote)
  batch   Batch?  @relation(fields: [batchId], references: [id])

  // Referencias externas
  referenceType String? // Ej: "PURCHASE_ORDER", "SALE", "ADJUSTMENT"
  referenceId   String? // ID del documento externo

  notes       String?
  performedBy String // userId que realizó el movimiento

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([type])
  @@index([reason])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Batch {
  id             String @id @default(uuid())
  productId      String
  organizationId String

  batchNumber  String // Número de lote proporcionado por proveedor
  serialNumber String? // Para productos con número de serie único

  // Fechas críticas
  manufacturingDate DateTime?
  expirationDate    DateTime? // Null = sin vencimiento

  // Estado del lote
  status BatchStatus @default(ACTIVO)

  // Cantidad actual en este lote específico
  initialQuantity Decimal @db.Decimal(15, 4)
  currentQuantity Decimal @db.Decimal(15, 4)

  // Costo unitario de este lote (para FIFO/PEPS)
  unitCost Decimal @db.Decimal(12, 4)

  // Ubicación física (opcional)
  location String? // Ej: "PASILLO-A-03"

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [productId, organizationId], references: [productId, organizationId])
  movements     StockMovement[]
  saleItems     SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNumber, organizationId])
  @@index([organizationId])
  @@index([productId])
  @@index([expirationDate])
  @@index([status])
  @@map("batches")
}

enum BatchStatus {
  ACTIVO
  RETENIDO // En cuarentena, esperando aprobación de calidad
  VENCIDO
  AGOTADO
}

// ==========================================
// FASE 3: Ventas/POS + Caja
// ==========================================

enum SaleStatus {
  PENDIENTE      // Venta iniciada, pendiente de pago
  COMPLETADA     // Venta pagada completamente
  CANCELADA      // Venta cancelada antes de completar
  DEVOLUCION     // Venta con devolución parcial o total
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  YAPE_PLIN
  CHEQUE
  CREDITO_TIENDA
}

model Sale {
  id             String @id @default(uuid())
  organizationId String
  
  // Número de comprobante/factura
  invoiceNumber String? @unique // Null si es borrador
  
  // Estado de la venta
  status SaleStatus @default(PENDIENTE)
  
  // Totales
  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2) // IGV/IVA
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @default(0) @db.Decimal(12, 2)
  
  // Información del cliente (opcional para ventas rápidas)
  customerId String?
  customerName String?
  customerDocument String? // DNI/RUC
  
  // Tipo de comprobante
  documentType String? // "FACTURA", "BOLETA", "TICKET"
  documentSeries String? // Serie del comprobante
  documentNumber String? // Número del comprobante
  
  // Notas adicionales
  notes String?
  
  // Usuario que realizó la venta
  userId String
  
  // Caja asociada (si aplica)
  cashRegisterId String?
  
  items SaleItem[]
  payments Payment[]
  
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  productId String
  
  // Cantidad vendida
  quantity Decimal @db.Decimal(15, 4)
  
  // Precio unitario al momento de la venta
  unitPrice Decimal @db.Decimal(12, 2)
  
  // Descuento aplicado a este item
  discount Decimal @default(0) @db.Decimal(12, 2)
  
  // Subtotal (quantity * unitPrice - discount)
  subtotal Decimal @db.Decimal(12, 2)
  
  // Porcentaje de impuesto aplicado (ej: 18% IGV)
  taxRate Decimal @default(0) @db.Decimal(5, 2)
  
  // Monto de impuesto
  taxAmount Decimal @db.Decimal(12, 2)
  
  // Total del item
  total Decimal @db.Decimal(12, 2)
  
  // Lote asignado (para trazabilidad)
  batchId String?
  
  product Product @relation(fields: [productId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch   Batch?  @relation(fields: [batchId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id             String @id @default(uuid())
  saleId         String
  organizationId String
  
  // Método de pago
  method PaymentMethod
  
  // Monto pagado
  amount Decimal @db.Decimal(12, 2)
  
  // Referencia externa (nro transacción, voucher, etc.)
  reference String?
  
  // Notas adicionales
  notes String?
  
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([saleId])
  @@index([organizationId])
  @@index([method])
  @@map("payments")
}

// Gestión de Caja
model CashRegister {
  id             String @id @default(uuid())
  organizationId String
  
  // Nombre de la caja (ej: "Caja Principal", "Caja 2")
  name String
  
  // Descripción opcional
  description String?
  
  // Estado actual
  status CashRegisterStatus @default(CERRADA)
  
  // Usuario responsable actual
  currentUserId String?
  
  // Fecha/hora de apertura
  openedAt DateTime?
  
  // Fecha/hora de cierre
  closedAt DateTime?
  
  // Monto inicial al abrir
  openingBalance Decimal @default(0) @db.Decimal(12, 2)
  
  // Monto final teórico (según movimientos)
  expectedClosingBalance Decimal @default(0) @db.Decimal(12, 2)
  
  // Monto final real (conteo físico)
  actualClosingBalance Decimal? @db.Decimal(12, 2)
  
  // Diferencia (real - teórico)
  difference Decimal? @db.Decimal(12, 2)
  
  // Notas de cierre
  closingNotes String?
  
  // Movimientos de esta caja
  movements CashRegisterMovement[]
  
  // Ventas realizadas en esta caja (relación inversa)
  // No se necesita campo adicional en Sale porque ya tiene cashRegisterId
  
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@map("cash_registers")
}

enum CashRegisterStatus {
  ABIERTA
  CERRADA
  EN_PAUSA
}

enum CashRegisterMovementType {
  APERTURA          // Saldo inicial
  INGRESO_VENTA     // Ingreso por venta
  INGRESO_OTRO      // Otros ingresos (devoluciones, etc.)
  SALIDA_GASTO      // Gastos operativos
  SALIDA_RETIRO     // Retiro de efectivo
  CIERRE            // Registro de cierre
  AJUSTE            // Ajuste por diferencia
}

model CashRegisterMovement {
  id               String @id @default(uuid())
  cashRegisterId   String
  organizationId   String
  
  // Tipo de movimiento
  type CashRegisterMovementType
  
  // Monto (positivo para ingresos, negativo para salidas)
  amount Decimal @db.Decimal(12, 2)
  
  // Es positivo? (true = ingreso, false = salida)
  isPositive Boolean
  
  // Método de pago asociado (si aplica)
  paymentMethod PaymentMethod?
  
  // Descripción del movimiento
  description String
  
  // Referencia a venta (si es ingreso por venta)
  saleId String?
  // La relación inversa está en Sale.payments
  
  // Usuario que realizó el movimiento
  performedBy String
  
  // Notas adicionales
  notes String?
  
  createdAt DateTime @default(now())
  
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([cashRegisterId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("cash_register_movements")
}
