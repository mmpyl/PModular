{
  "name": "pymen-enterprise-boilerplate",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "start:backend": "npm run start -w backend",
    "start:frontend": "npm run start -w frontend",
    "prisma:generate": "npm run prisma:generate -w backend",
    "prisma:migrate:deploy": "npm exec --workspace backend prisma migrate deploy",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend"
  }
}
